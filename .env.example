# scholarposter environment variables
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# ── Mastodon ──────────────────────────────────────────────────────────────────
# Auto-managed by 'scholarposter auth mastodon' — do not edit manually.
# MASTODON_INSTANCE=

# ── Bluesky ───────────────────────────────────────────────────────────────────
# Use an App Password, NOT your account password.
# Create one at: Settings > Privacy and Security > App Passwords
BLUESKY_EMAIL="you@example.com"
BLUESKY_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# ── LinkedIn ──────────────────────────────────────────────────────────────────
# Create a LinkedIn Developer app with "Share on LinkedIn" (or "Community
# Management API") and "Sign In with LinkedIn using OpenID Connect" products.
# See docs/auth-linkedin.md for setup.
#
# Fill in Client ID and Client Secret, then run: scholarposter auth linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# These are auto-managed by 'scholarposter auth linkedin' — do not edit manually:
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_OWNER_URN=
# LINKEDIN_TOKEN_EXPIRES_AT=
