# scholarposter environment variables
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# ── Bluesky ───────────────────────────────────────────────────────────────────
# Use an App Password, NOT your account password.
# Create one at: Settings > Privacy and Security > App Passwords
BLUESKY_EMAIL="you@example.com"
BLUESKY_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# ── LinkedIn ──────────────────────────────────────────────────────────────────
# Requires the Community Management API product on your LinkedIn Developer app.
# See docs/auth-linkedin.md for the full OAuth setup walkthrough.
LINKEDIN_ACCESS_TOKEN="AQX..."
LINKEDIN_OWNER_URN="urn:li:person:XXXXXXXXXX"
